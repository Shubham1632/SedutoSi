# Local edge-function secrets — read automatically by `supabase start` /
# `supabase functions serve`. Separate from the root .env.example (that one
# is for the mobile app + migrations; this one is for the Deno runtime).
#
#     cp supabase/functions/.env.example supabase/functions/.env
#
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected
# automatically for local functions — don't add them here.

STRIPE_SECRET_KEY="sk_test_..."
