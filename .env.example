# =============================================================================
# CinemaMilano — environment variables
# =============================================================================
# Copy this file to `.env` and fill in your values:
#     cp .env.example .env
#
# EXPO_PUBLIC_* vars are compiled into the mobile bundle — only put
# public/anon values there. Everything else is server-only.
# =============================================================================


# -----------------------------------------------------------------------------
# Supabase  (required)
# -----------------------------------------------------------------------------
# Local dev: run `supabase start` — it prints the URL and keys.
# For hosted: copy from Supabase Dashboard → Project Settings → API.

# Mobile app (Expo)
EXPO_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
EXPO_PUBLIC_SUPABASE_ANON_KEY=""

# Server / admin (used by Supabase edge functions if you add any)
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""        # bypasses RLS — keep secret
SUPABASE_DB_URL=""                  # direct postgres URL (for migrations)

# The local API_URL is just used as a placeholder — mobile app calls Supabase directly.
EXPO_PUBLIC_API_URL="http://localhost:3000"

# EAS / Expo Go
# EXPO_PUBLIC_EAS_PROJECT_ID=""
# EXPO_PUBLIC_AUTH_SCHEME="cinemamilano"


# -----------------------------------------------------------------------------
# Google sign-in  (optional — works in Expo Go, no dev build required)
# -----------------------------------------------------------------------------
# Consumed by `supabase/config.toml` ([auth.external.google]) — the client
# secret never touches the mobile app, since Supabase does the OAuth code
# exchange server-side. Get these from Google Cloud Console → APIs & Services
# → Credentials → an OAuth 2.0 "Web application" client, with authorized
# redirect URI:
#   http://127.0.0.1:54321/auth/v1/callback   (local dev)
#   https://<project-ref>.supabase.co/auth/v1/callback   (hosted)
# After setting these, flip `enabled = true` under [auth.external.google] in
# supabase/config.toml and restart `supabase start`.
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=""
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=""


# -----------------------------------------------------------------------------
# Stripe  (required for booking payments)
# -----------------------------------------------------------------------------
# Payment happens via Stripe Checkout (a hosted page opened in the system
# browser) — created and verified by the `stripe-create-checkout-session` /
# `stripe-confirm-payment` Supabase edge functions. Only the secret key is
# needed; there's no publishable key in the mobile app since it never talks
# to Stripe directly. Card, Apple Pay, Google Pay and Revolut Pay all show up
# automatically on the hosted Checkout page as long as they're enabled for
# your account in Stripe Dashboard → Settings → Payment methods.
#
# Neither edge function reads the root .env below — it's just documenting the
# variable name for reference. Two separate things must both be done for a
# hosted (no local Supabase) project, from a project already `supabase link`ed:
#
#   1. Push the secret to the hosted project:
#        supabase secrets set STRIPE_SECRET_KEY=sk_test_...
#      (`supabase secrets list` should then show it.)
#   2. Deploy the two functions (they don't exist on the server until you do):
#        supabase functions deploy stripe-create-checkout-session
#        supabase functions deploy stripe-confirm-payment
#      (`supabase functions list` should then show both.)
#
# Both commands talk to the hosted project directly — no `supabase start` /
# Docker needed. Re-run the deploy step after editing either function's code.
#
# Local dev only (`supabase start`): the local edge runtime instead reads
# supabase/functions/.env (gitignored, see supabase/functions/.env.example) —
# `supabase secrets set` has no effect on it.
STRIPE_SECRET_KEY="sk_test_..."
# Not used yet — Checkout sessions are verified synchronously when the app
# returns from the browser, no webhook required. Reserved for later.
# STRIPE_WEBHOOK_SECRET="whsec_..."
