# =============================================================================
# CinemaMilano — environment variables
# =============================================================================
# Copy this file to `.env` and fill in your values:
#     cp .env.example .env
#
# EXPO_PUBLIC_* vars are compiled into the mobile bundle — only put
# public/anon values there. Everything else is server-only.
# =============================================================================


# -----------------------------------------------------------------------------
# Supabase  (required)
# -----------------------------------------------------------------------------
# Local dev: run `supabase start` — it prints the URL and keys.
# For hosted: copy from Supabase Dashboard → Project Settings → API.

# Mobile app (Expo)
EXPO_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
EXPO_PUBLIC_SUPABASE_ANON_KEY=""

# Server / admin (used by Supabase edge functions if you add any)
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""        # bypasses RLS — keep secret
SUPABASE_DB_URL=""                  # direct postgres URL (for migrations)

# The local API_URL is just used as a placeholder — mobile app calls Supabase directly.
EXPO_PUBLIC_API_URL="http://localhost:3000"

# EAS / Expo Go
# EXPO_PUBLIC_EAS_PROJECT_ID=""
# EXPO_PUBLIC_AUTH_SCHEME="cinemamilano"


# -----------------------------------------------------------------------------
# Google sign-in  (optional — works in Expo Go, no dev build required)
# -----------------------------------------------------------------------------
# Consumed by `supabase/config.toml` ([auth.external.google]) — the client
# secret never touches the mobile app, since Supabase does the OAuth code
# exchange server-side. Get these from Google Cloud Console → APIs & Services
# → Credentials → an OAuth 2.0 "Web application" client, with authorized
# redirect URI:
#   http://127.0.0.1:54321/auth/v1/callback   (local dev)
#   https://<project-ref>.supabase.co/auth/v1/callback   (hosted)
# After setting these, flip `enabled = true` under [auth.external.google] in
# supabase/config.toml and restart `supabase start`.
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=""
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=""


# -----------------------------------------------------------------------------
# Stripe  (optional — for payment integration)
# -----------------------------------------------------------------------------
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
